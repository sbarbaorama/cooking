{
  "name": "Ricettario",
  "short_name": "Ricettario",
  "description": "Il tuo ricettario personale con dispensa, lista della spesa e menu settimanale.",
  "lang": "it",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#faf7f2",
  "theme_color": "#c2410c",
  "categories": ["food", "lifestyle"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Nuova ricetta", "url": "./#/import", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Cosa cucino?", "url": "./#/pantry", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lista della spesa", "url": "./#/shopping", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  }
}
